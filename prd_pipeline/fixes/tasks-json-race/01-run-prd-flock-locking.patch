-# Wrapper for tsk command to always use the correct tasks file
-# Defined early so auto-resume can use it
+# Serialized access to tasks.json.
+#
+# tsk is an unlocked read-modify-write: TaskManager loads the file in its
+# constructor and saves with fs.writeFileSync (no flock, no atomic rename).
+# Two callers write the SAME tasks file concurrently in this pipeline:
+#   - the foreground executor  (status -> Researching/Implementing/Complete)
+#   - the background research supervisor subshell (status -> Researching/Ready
+#     for items chained ahead by RESEARCH_DEPTH)
+# Their read-modify-write cycles can interleave and the loser's update is
+# silently dropped. Symptom: the supervisor's "...Ready" write clobbers the
+# executor's just-written "Implementing", so an item visibly sits at "Ready"
+# for the entire ~minutes-long implementation, then jumps straight to
+# "Complete". Fix: every read AND write takes an exclusive flock on a per-file
+# lockfile. The `( flock 9; ... ) 9>lock` recipe scopes fd 9 to the subshell,
+# so it is safe under recursion and is inherited correctly by the backgrounded
+# supervisor subshell. Requires flock (util-linux), standard on Linux.
+tsk_locked() {
+    local _f="$1"; shift
+    ( flock 9
+      tsk -f "$_f" "$@" < /dev/null
+    ) 9>"${_f}.lock"
+}
+
+# Wrapper for tsk command to always use the correct tasks file (now locked).
+# Defined early so auto-resume can use it. Routes reads AND writes through
+# tsk_locked so concurrent supervisor/restore writes can't lose updates or
+# serve a torn read.
 tsk_cmd() {
-    tsk -f "$TASKS_FILE" "$@" < /dev/null
+    tsk_locked "$TASKS_FILE" "$@"
 }
 
